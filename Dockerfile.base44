# Base44 development image for the WagwanSpark beat store.
#
# The store is a Cloudflare Worker (src/index.js) that needs the Workers
# runtime, so this image only installs the toolchain (Wrangler). The repository
# is bind-mounted at runtime and Wrangler serves it from source, so edits show
# up without rebuilding this image.
FROM node:22

RUN npm install -g wrangler@4

WORKDIR /app
